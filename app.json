{
  "expo": {
    "name": "PayProTec",
    "slug": "payprotec-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.payprotec.partner"
    },
    "android": {
      "package": "com.payprotec.partner",
      "adaptiveIcon": {
        "backgroundColor": "#004990"
      },
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "PayProTec uses the camera to scan terminal serial numbers and barcodes."
        }
      ]
    ],
    "newArchEnabled": false
  }
}
